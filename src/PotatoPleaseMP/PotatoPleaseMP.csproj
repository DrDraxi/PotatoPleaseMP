<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 6 be.791 (IL2CPP, CoreCLR) plugin for Potato Please. Compiles against:
       - BepInEx core DLLs in .tools/bepinex (scripts/setup.ps1 fetches them)
       - the game's interop assemblies in lib/interop (generated by BepInEx on the test copy's first start; not committed) -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PotatoPleaseMP</AssemblyName>
    <RootNamespace>PotatoPleaseMP</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(RepoRoot).tools\bepinex\BepInEx\core</BepInExCore>
    <InteropDir Condition="'$(InteropDir)' == ''">$(RepoRoot)lib\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PotatoPleaseMP.Core/PotatoPleaseMP.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)/MonoMod.RuntimeDetour.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2CppSystem.dll" Private="false" />
    <Reference Include="$(InteropDir)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(InteropDir)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.AudioModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(InteropDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(InteropDir)/Unity.Localization.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(InteropDir)\Unity.Collections.dll" Private="false" />
    <Reference Include="$(InteropDir)/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

</Project>
